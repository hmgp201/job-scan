{
  "name": "job-watch",
  "version": "1.0.0",
  "private": true,
  "description": "Job board watcher: scans ATS APIs, filters, alerts to Telegram. Runs locally (CLI) or on a schedule via GitHub Actions (.github/workflows/scan.yml).",
  "main": "job_watch.js",
  "scripts": {
    "scan": "node job_watch.js",
    "watch": "node job_watch.js --watch=900",
    "scan:hiringcafe": "node hiring_cafe_scan.js",
    "scan:ukdesign": "node job_watch.js --config=uk-design",
    "scan:ukdesign:hiringcafe": "node hiring_cafe_scan.js --config=uk-design",
    "scan:ukdesign:adzuna": "node adzuna_scan.js --config=uk-design",
    "scan:ukdesign:reed": "node reed_scan.js --config=uk-design",
    "query:adzuna": "node adzuna_query.js",
    "query:reed": "node reed_query.js"
  },
  "engines": {
    "node": ">=18"
  }
}
